import random
n = random.randint(1,50)
a =-1
guesses = 1
while (a!=n):
    a = int(input("Guess the number between 1 and 50: "))
    
    if (a>n):
        print("Too high! Try again.")
        guesses+=1

    elif(a<n):
        print("Too Low! Try again.")
        guesses+=1
print("_----------------------------------------------------------------------_")
print(f"Congratulations! You guessed the number {n} in {guesses} guesses.")
